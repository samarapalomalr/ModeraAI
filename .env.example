# ============================================================
# ModeraAI - variáveis de ambiente (MODELO)
# Copie para .env e preencha:   cp .env.example .env
# NUNCA versione o arquivo .env (contém chaves secretas)
# ============================================================

# --- Integrações externas (OBRIGATÓRIAS) ---
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Apify: https://console.apify.com/account/integrations
APIFY_API_KEY=

# --- Portas expostas na sua máquina (host) ---
FRONTEND_PORT=5173
BACKEND_PORT=8000
# Interface web do banco (sqlite-web) - exposta apenas em 127.0.0.1
SQLITE_WEB_PORT=8080

# --- Banco de dados (SQLite) ---
# Nome do arquivo dentro do volume Docker "sqlite_data" (/data)
SQLITE_DB_FILE=moderaai.db

# --- Desenvolvimento ---
# Hot reload do frontend via polling.
# Use true no Windows/macOS (Docker Desktop); pode ser false no Linux.
CHOKIDAR_USEPOLLING=true
