# ============================================================
# ModeraAI - variáveis de ambiente (modelo)
# Copie para .env e preencha:  cp .env.example .env
# NUNCA versione o arquivo .env (contém chaves secretas)
# ============================================================

# --- Integrações externas (obrigatórias) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# https://console.apify.com/account/integrations
APIFY_API_KEY=your_apify_api_key_here

# --- Backend ---
DEBUG=true
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
BACKEND_PORT=8000

# --- Banco de dados (SQLite) ---
# Nome do arquivo dentro do volume Docker (/data)
SQLITE_DB_FILE=moderaai.db
# Interface web do banco (sqlite-web)
SQLITE_WEB_PORT=8080

# --- Frontend ---
FRONTEND_PORT=5173
# URL do backend vista pelo navegador
VITE_API_URL=http://localhost:8000
